# © 2026 Agus Supriyadi — Blog Dulur. Hak cipta dilindungi undang-undang.
# =====================================================
# Blog Dulur — .htaccess (Apache / XAMPP / shared hosting)
# Letakkan file ini di root: /blog-dulur/.htaccess
# =====================================================

DirectoryIndex index.php index.html
Options -Indexes
ServerSignature Off
AddDefaultCharset UTF-8

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Jika dipindah ke hosting (document root), biarkan commented.
  # Jika diakses via subfolder dan rewrite bermasalah, uncomment:
  # RewriteBase /blog-dulur/

  # --- Canonical: hilangkan trailing slash ganda, dsb (aman) ---

  # --- Pretty URL ---
  # /post/judul-artikel   -> post.php?slug=judul-artikel
  # /artikel/judul-artikel (alias ID) -> post.php?slug=
  # /halaman/tentang      -> page.php?slug=tentang (KANONIS, dipakai page_url())
  # /page/tentang         -> page.php?slug=tentang (alias kompatibel link lama)
  # Syarat: file/folder fisik tetap diakses langsung (assets, api, admin).

  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^post/([^/]+)/?$ post.php?slug=$1 [L,QSA]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^artikel/([^/]+)/?$ post.php?slug=$1 [L,QSA]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^halaman/([^/]+)/?$ page.php?slug=$1 [L,QSA]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^page/([^/]+)/?$ page.php?slug=$1 [L,QSA]

  # Pagination cantik (opsional): /hal/2 -> index.php?page=2
  # Dinonaktifkan default agar tidak konflik dengan slug halaman statis.
  # Aktifkan bila butuh:
  # RewriteCond %{REQUEST_FILENAME} !-f
  # RewriteCond %{REQUEST_FILENAME} !-d
  # RewriteRule ^hal/([0-9]+)/?$ index.php?page=$1 [L,QSA]

  # --- Redirect www / HTTPS (produksi, opsional - uncomment bila perlu) ---
  # RewriteCond %{HTTPS} off
  # RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]
</IfModule>

# =====================================================
# KEAMANAN: blokir file sensitif
# =====================================================
<FilesMatch "^(\.env|\.env\..*|config\.php|database\.sql|.*\.sql|.*\.log|package(-lock)?\.json|README\.md|PANDUAN\.md)$">
  Require all denied
</FilesMatch>

# Blokir akses langsung ke folder sensitif
RedirectMatch 403 ^/.*\.git/.*$
RedirectMatch 403 ^/(includes|admin/includes)(/|$)

# Larang browsing composer/npm sisa bila ada
<FilesMatch "^(composer\.(json|lock)|npm-debug\.log|yarn-error\.log)$">
  Require all denied
</FilesMatch>

# Lindungi .htaccess itu sendiri
<Files ".htaccess">
  Require all denied
</Files>

# =====================================================
# SECURITY HEADERS (hanya jika mod_headers aktif)
# =====================================================
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # HSTS: aktifkan HANYA jika sudah full HTTPS
  # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

# =====================================================
# PERFORMANCE: kompresi + cache (hanya jika modul aktif)
# =====================================================
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpg "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/gif "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType text/css "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"
  ExpiresByType application/json "access plus 1 hour"
  ExpiresDefault "access plus 1 day"
</IfModule>

# Lindungi dari akses file tanpa ekstensi aneh di uploads bila ada
<IfModule mod_autoindex.c>
  IndexIgnore *
</IfModule>
