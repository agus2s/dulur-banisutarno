# Contoh konfigurasi Blog Dulur — salin jadi .env lalu sesuaikan.
# cp .env.example .env   (atau copy-paste manual di Windows Explorer)

# Database (MySQL / XAMPP)
DB_HOST=localhost
DB_NAME=blog_dulur
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# Situs (opsional, kosongkan = otomatis)
# BASE_URL=/blog-dulur
BASE_URL=

# URL kanonis untuk URL absolut (media, dsb). Kosongkan = otomatis dari request.
# Di produksi (mis. dulur.my.id) disarankan diisi agar konsisten:
# SITE_URL=https://dulur.my.id
SITE_URL=

# Artikel per halaman
POSTS_PER_PAGE=6

# Salt hash identitas pengunjung untuk fitur like (ganti dengan string acak)
LIKE_SALT=blog-dulur-likes
